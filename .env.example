# Copy to .env and fill in. Never commit .env.

# --- LLM (pick one; leave all empty for keyless replay mode) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o              # screenshot vs design review (advisory)
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint (Gemini, GitHub Models, Groq...)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
# LLM_PROVIDER=replay         # force replay even when a key is set
# LLM_RECORD=1                # save live LLM outputs into llm/replay/ for repeatable demos

# --- RAG embeddings: openai (needs OPENAI_API_KEY) or hashing (offline) ---
# EMBEDDING_PROVIDER=hashing
# EMBEDDING_MODEL=text-embedding-3-small

# --- StageUI application under test ---
STAGE_BASE_URL=http://127.0.0.1:5055
STAGE_USER=alice
STAGE_PASSWORD=               # required: choose any password; the seed sets it for 'alice'
# STAGE_BOB_PASSWORD=         # optional; random if unset
# STAGE_SECRET_KEY=           # optional Flask session key; random per start if unset

# --- Figma MCP source: fixture (mock) or rest (real Figma file) ---
FIGMA_SOURCE=fixture
# FIGMA_TOKEN=
# FIGMA_FILE_KEY=

# --- Agent behaviour ---
HEADLESS=true
MAX_RECOVERY_ATTEMPTS=2
STEP_TIMEOUT_MS=5000
