# Copy to .env and fill in. Never commit .env.

# --- LLM (pick one; leave all empty for keyless replay mode) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o              # screenshot vs design review (advisory)
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint (Gemini, GitHub Models, Groq...)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o
# LLM_PROVIDER=replay         # force replay even when a key is set
# LLM_RECORD=1                # save live LLM outputs into llm/replay/ for repeatable demos

# --- RAG embeddings: openai (needs OPENAI_API_KEY) or hashing (offline) ---
# EMBEDDING_PROVIDER=hashing
# EMBEDDING_MODEL=text-embedding-3-small
# RAG_MODE=hybrid                # hybrid, dense, or lexical
# RAG_MIN_SCORE=                 # optional final-score threshold
# RAG_RRF_K=60

# --- StageUI application under test ---
# New generic names take precedence; legacy STAGE_* variables remain supported.
TARGET_ADAPTER=stageui             # stageui or generic_web
TARGET_BASE_URL=http://127.0.0.1:5055
TARGET_USER=alice
TARGET_PASSWORD=
TARGET_AUTH_METHOD=form            # form, storage_state, headers, none
# TARGET_PROFILE=config/apps/generic.example.json
# TARGET_FEATURE_MAP=config/features.json
# TARGET_STORAGE_STATE=.auth/storage-state.json
# TARGET_HEADERS_JSON={"Authorization":"Bearer ..."}
# TARGET_HEALTH_PATH=/
# TARGET_ALLOWED_ORIGINS=https://stage.example.com
# TARGET_READ_ONLY=true

# Legacy aliases:
STAGE_BASE_URL=http://127.0.0.1:5055
STAGE_USER=alice
STAGE_PASSWORD=               # required: choose any password; the seed sets it for 'alice'
# STAGE_BOB_PASSWORD=         # optional; random if unset
# STAGE_SECRET_KEY=           # optional Flask session key; random per start if unset

# --- Figma MCP source: fixture (mock) or rest (real Figma file) ---
FIGMA_SOURCE=fixture
# FIGMA_TOKEN=
# FIGMA_FILE_KEY=

# --- Optional controlled performance assurance (disabled by default) ---
PERFORMANCE_ENABLED=false
PERFORMANCE_AUTO_RUN=false
PERFORMANCE_CONFIG=config/performance.json
PERFORMANCE_BASELINES_DIR=performance-baselines
PERFORMANCE_FAIL_ON_REGRESSION=true
PERFORMANCE_REQUIRE_BASELINE=false
PERFORMANCE_MIN_SAMPLES=3
PERFORMANCE_MAX_CV=0.35

# --- Optional advisory output evaluation (disabled; never changes verdicts) ---
ADVISORY_EVALUATION_ENABLED=false
ADVISORY_EVALUATION_CONFIG=config/advisory-evaluation.json
# For Ollama: http://127.0.0.1:11434/v1, no API key required.
# For vLLM: set judge.base_url to its OpenAI-compatible /v1 endpoint.
# For a remote OpenAI-compatible judge, set the key named by judge.api_key_env.
ADVISORY_EVALUATION_API_KEY=

# --- Requirements Alchemist (Figma/PRD to reviewable Jira stories) ---
REQUIREMENTS_ALCHEMIST_CONFIG=config/requirements-alchemist.json
RA_LLM_PROVIDER=replay
RA_LLM_MODEL=gpt-4o-mini
# RA_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Local Ollama profile: config/requirements-alchemist.ollama.json
# OLLAMA_API_KEY is intentionally unnecessary for a local endpoint.
# FIGMA_ACCESS_TOKEN=
# ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
# ATLASSIAN_EMAIL=
# ATLASSIAN_API_TOKEN=
# JIRA_PROJECT_KEY=PROJ
RA_JIRA_PUSH_ENABLED=false
RA_REQUIRE_HUMAN_APPROVAL=true

# --- Agent behaviour ---
HEADLESS=true
MAX_RECOVERY_ATTEMPTS=2
STEP_TIMEOUT_MS=5000
