<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Stage Assurance Report · {{ meta.run_id }}</title>
<style>
  body { font-family: system-ui, sans-serif; margin: 24px; color: #1d2330; background: #f7f8fa; }
  h1 { margin-bottom: 4px; }
  h2 { margin-top: 0; }
  .muted { color: #6b7280; font-size: 13px; }
  .card { background: #fff; border-radius: 8px; padding: 16px 20px; margin: 16px 0; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; vertical-align: top; padding: 6px 8px; border-bottom: 1px solid #e5e7eb; }
  .label { font-weight: 700; padding: 2px 8px; border-radius: 4px; color: #fff; font-size: 12px; white-space: nowrap; }
  .PASS { background: #2f9e44; } .GAP { background: #e67700; } .DEFECT { background: #c92a2a; } .RISK { background: #6741d9; }
  details { margin: 6px 0; } summary { cursor: pointer; }
  code { font-size: 12px; }
  .ok, .matched { color: #2f9e44; } .approved_variance { color: #b76e00; }
  .missing, .mismatch, .error, .refused { color: #c92a2a; } .recovered { color: #6741d9; } .skipped { color: #9ca3af; }
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 12px 0; }
  .compare figure { margin: 0; }
  .compare figcaption { font-weight: 600; font-size: 13px; margin-bottom: 6px; }
  .shot { position: relative; border: 1px solid #d0d4db; border-radius: 6px; overflow: hidden; }
  .shot img { display: block; width: 100%; }
  .mark { position: absolute; border: 3px solid #c92a2a; border-radius: 4px; background: rgba(201,42,42,.08); }
  .mark.variance { border-color: #e67700; background: rgba(230,119,0,.06); }
  .mark span { position: absolute; top: -22px; left: -3px; background: #c92a2a; color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 3px; white-space: nowrap; }
  .mark.variance span { background: #e67700; }
  .sev-high { color: #c92a2a; font-weight: 700; } .sev-medium { color: #b76e00; font-weight: 700; } .sev-low { color: #6b7280; }
  .legend span { margin-right: 12px; }
</style>
</head>
<body>
<h1>Stage Requirement &amp; UX Assurance Report</h1>
<div class="muted">
  Run {{ meta.run_id }} · generated {{ generated }} · Author {{ meta.author }} · Stage {{ meta.stage_base_url }} · LLM {{ meta.llm_provider }} ({{ meta.llm_model }})
  · UX source {{ meta.ux_source }} · RAG {{ meta.embedder }}
</div>

{% if frames %}
<div class="card">
  <h2>Figma conformance: does the implementation match the design?</h2>
  <table>
    <tr><th>Frame</th><th>Route</th><th>Result</th><th>Components</th><th>Prototype flows</th><th>Visual review</th><th>Reason</th></tr>
    {% for f in frames %}
    {% set matched = f.components | selectattr('status', 'in', ['matched', 'approved_variance']) | list | length %}
    {% set checked = f.components | rejectattr('status', 'equalto', 'skipped') | list | length %}
    {% set flows_ok = f.flows | selectattr('status', 'equalto', 'ok') | list | length %}
    <tr>
      <td><a href="#frame-{{ loop.index }}">{{ f.frame }}</a> <span class="muted">({{ f.node_id }})</span></td>
      <td><code>{{ f.route }}</code></td>
      <td><span class="label {{ f.label }}">{{ f.label }}</span></td>
      <td>{{ matched }}/{{ checked }} match</td>
      <td>{{ flows_ok }}/{{ f.flows | length }} correct</td>
      <td>{% if f.visual_review %}{{ f.visual_review.observations | length }} note(s){% else %}<span class="muted">n/a</span>{% endif %}</td>
      <td>{{ f.rationale }}</td>
    </tr>
    {% endfor %}
  </table>
  <p class="muted">Labels come from deterministic checks of components, control types, labels and prototype navigation.
  The visual review is an advisory comparison of the two screenshots by a vision model and never changes a label.</p>
</div>

{% for f in frames %}
<div class="card" id="frame-{{ loop.index }}">
  <h2>{{ f.frame }} <span class="label {{ f.label }}">{{ f.label }}</span></h2>
  <p>{{ f.rationale }}</p>
  <div class="compare">
    <figure>
      <figcaption>Approved design (Figma frame {{ f.node_id }})</figcaption>
      <div class="shot">
        {% if f.design_image %}<img src="{{ f.design_image }}" alt="Figma design for {{ f.frame }}">{% endif %}
        {% for c in f.components if c.box and c.status in ['missing', 'mismatch', 'approved_variance'] %}
        <div class="mark {{ 'variance' if c.status == 'approved_variance' else '' }}"
             style="left:{{ c.box.x / f.design_size.width * 100 }}%;top:{{ c.box.y / f.design_size.height * 100 }}%;width:{{ c.box.width / f.design_size.width * 100 }}%;height:{{ c.box.height / f.design_size.height * 100 }}%">
          <span>{{ c.label }}: {{ 'approved variance' if c.status == 'approved_variance' else c.status }}</span>
        </div>
        {% endfor %}
      </div>
    </figure>
    <figure>
      <figcaption>Implemented screen (Stage <code>{{ f.route }}</code>)</figcaption>
      <div class="shot"><img src="{{ f.live_image }}" alt="Live screen for {{ f.frame }}"></div>
    </figure>
  </div>
  <div class="legend muted"><span style="color:#c92a2a">■ does not match design</span><span style="color:#e67700">■ approved variance</span></div>

  <h3>Components</h3>
  <table>
    <tr><th>Figma node</th><th>Kind</th><th>Label</th><th>Result</th><th>Detail</th></tr>
    {% for c in f.components %}
    <tr><td>{{ c.node_id }}</td><td>{{ c.kind }}</td><td>{{ c.label }}</td><td class="{{ c.status }}">{{ c.status }}</td><td>{{ c.detail }}</td></tr>
    {% endfor %}
  </table>

  {% if f.flows %}
  <h3>Prototype flows</h3>
  <table>
    <tr><th>Trigger</th><th>Design destination</th><th>Expected route</th><th>Observed</th><th>Result</th><th>Detail</th></tr>
    {% for fl in f.flows %}
    <tr><td>{{ fl.trigger_label }}</td><td>{{ fl.to_frame }}</td><td><code>{{ fl.expected_path }}</code></td><td><code>{{ fl.observed_url }}</code></td><td class="{{ fl.status }}">{{ fl.status }}</td><td>{{ fl.detail }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}

  {% if f.visual_review %}
  <h3>Visual review (advisory)</h3>
  <p>{{ f.visual_review.summary }}</p>
  {% if f.visual_review.observations %}
  <table>
    <tr><th>Area</th><th>Difference</th><th>Severity</th></tr>
    {% for o in f.visual_review.observations %}
    <tr><td>{{ o.area }}</td><td>{{ o.difference }}</td><td class="sev-{{ o.severity }}">{{ o.severity }}</td></tr>
    {% endfor %}
  </table>
  {% endif %}
  {% endif %}
  <p class="muted">Evidence: <a href="{{ f.design_image }}">design.png</a> · <a href="{{ f.live_image }}">live.png</a> ·
    trace <code>playwright show-trace {{ f.trace_path }}</code> · <a href="{{ f.trace_path | replace('trace.zip', 'verdict.json') }}">verdict.json</a></p>
</div>
{% endfor %}
{% endif %}

{% if stories %}
<div class="card">
  <h2>Requirement assurance by story</h2>
  <table>
    <tr><th>Story</th><th>Title</th><th>Result</th><th>ACs</th><th>Duration</th><th>LLM calls / tokens</th></tr>
    {% for s in stories %}
    <tr>
      <td><a href="#{{ s.story_key }}">{{ s.story_key }}</a></td>
      <td>{{ s.title }}</td>
      <td><span class="label {{ s.label }}">{{ s.label }}</span></td>
      <td>{% for v in s.ac_verdicts %}<span class="label {{ v.label }}" title="{{ v.ac_id }}">{{ v.ac_id }}</span> {% endfor %}</td>
      <td>{{ (s.duration_ms / 1000) | round(1) }} s</td>
      <td>{{ s.llm_usage.calls }} / {{ s.llm_usage.prompt_tokens + s.llm_usage.completion_tokens }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

{% for s in stories %}
<div class="card" id="{{ s.story_key }}">
  <h2>{{ s.story_key }}: {{ s.title }} <span class="label {{ s.label }}">{{ s.label }}</span></h2>
  {% if s.error %}<p class="error"><b>Run error:</b> {{ s.error }}</p>{% endif %}
  <p><b>Recommendation:</b> {{ s.recommendation }}</p>
  <p class="muted">Intent: <a href="{{ s.intent_path }}">{{ s.intent_path }}</a> · Scenarios: <a href="{{ s.scenarios_path }}">{{ s.scenarios_path }}</a></p>

  <table>
    <tr><th>AC</th><th>Requirement</th><th>Result</th><th>Rationale</th><th>Evidence</th></tr>
    {% for v in s.ac_verdicts %}
    <tr>
      <td>{{ v.ac_id }}</td>
      <td>{{ v.text }}</td>
      <td><span class="label {{ v.label }}">{{ v.label }}</span></td>
      <td>{{ v.rationale }}</td>
      <td>{% for e in v.evidence %}<a href="{{ e }}">{{ e.split('/')[-1] }}</a><br>{% endfor %}</td>
    </tr>
    {% endfor %}
  </table>

  {% for sr in s.scenario_results %}
  <details>
    <summary>{{ sr.scenario_id }} ({{ sr.ac_ids | join(', ') }}): {{ sr.title }} · {{ (sr.duration_ms / 1000) | round(1) }} s</summary>
    <table>
      <tr><th>#</th><th>Step</th><th>Status</th><th>Detail</th><th>Screenshot</th></tr>
      {% for st in sr.steps %}
      <tr>
        <td>{{ st.index }}</td>
        <td><code>{{ st.description }}</code></td>
        <td class="{{ st.status }}">{{ st.status }}</td>
        <td>{{ st.detail }}
          {% if st.data.rows %}
          <table>
            <tr><th>Post</th><th>Source words</th><th>UI</th><th>API</th><th>Expected</th><th>Finding</th></tr>
            {% for r in st.data.rows %}
            <tr><td>{{ r.title }}</td><td>{{ r.source_words }}</td><td>{{ r.ui }}</td><td>{{ r.api }}</td><td>{{ r.expected }}</td><td>{{ r.finding }}</td></tr>
            {% endfor %}
          </table>
          {% endif %}
          {% if st.data.findings %}
          <table>
            <tr><th>Figma node</th><th>Kind</th><th>Label</th><th>Status</th><th>Detail</th></tr>
            {% for f in st.data.findings %}
            <tr><td>{{ f.node_id }}</td><td>{{ f.kind }}</td><td>{{ f.label }}</td><td class="{{ f.status }}">{{ f.status }}</td><td>{{ f.detail }}</td></tr>
            {% endfor %}
          </table>
          {% endif %}
        </td>
        <td>{% if st.screenshot %}<a href="{{ s.story_key }}/{{ sr.scenario_id }}/{{ st.screenshot }}">png</a>{% endif %}</td>
      </tr>
      {% endfor %}
    </table>
    <p class="muted">Trace: <code>playwright show-trace {{ s.story_key }}/{{ sr.scenario_id }}/trace.zip</code> · Network: <a href="{{ s.story_key }}/{{ sr.scenario_id }}/network.json">network.json</a></p>
  </details>
  {% endfor %}
</div>
{% endfor %}
<p class="muted">Stage Requirement &amp; UX Assurance · Vivek Kaushik</p>
</body>
</html>
